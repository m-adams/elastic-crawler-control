# Elastic Crawler Service - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Elasticsearch Configuration (required for crawl output)
# =============================================================================
ES_URL=https://your-elasticsearch-url:9243
ES_API_KEY=your-api-key

# =============================================================================
# LLM Proxy Configuration (optional - enables AI-powered config generation)
# =============================================================================
# The service supports the Elastic LLM Proxy (OpenAI-compatible endpoint).
# Get your API key at: https://sa-workshops.prod-3.eden.elastic.dev/LLM_Key_Generator

# Base URL for Agno framework (OpenAI-compatible, ends with /v1)
# This is used by the Agno AI agent framework for structured agent interactions
LLM_PROXY_BASE_URL=https://litellm-proxy-service-1059491012611.us-central1.run.app/v1

# Full URL for direct API calls (legacy, used by llm_client.py for streaming)
LLM_PROXY_URL=https://litellm-proxy-service-1059491012611.us-central1.run.app/v1/chat/completions

# API Key for LLM Proxy (leave empty to disable AI features)
LLM_PROXY_API_KEY=

# Model to use (default: claude-sonnet-4)
# Available models depend on your LLM Proxy configuration
LLM_MODEL=claude-sonnet-4

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8000
ENVIRONMENT=development
